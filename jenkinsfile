pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'develop',
                    url: 'https://github.com/Avani129/nopCommerce.git'
            }
        }

        stage('Restore') {
            steps {
                sh 'dotnet restore src/nopCommerce.sln'
            }
        }

        stage('Build') {
            steps {
                sh 'dotnet build src/nopCommerce.sln -c Release'
            }
        }
    }
}
